            "description": "User created"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user and set cookies",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout user",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Token refreshed"
          }
        }
      }
    },
